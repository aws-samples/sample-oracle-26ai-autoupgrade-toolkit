#==============================================================================
# Optional secrets file for the migration toolkit.
#
# Database authentication uses OS authentication ('/ as sysdba') and needs NO
# secret. This file exists only for the rare value that cannot use OS auth,
# such as the SSH transport password or the Oracle Net source password below.
#
# USAGE:
#   1. Copy this file to a private location, e.g. ~/.migration/secrets.env
#   2. chmod 600 <file>              # the toolkit refuses any other mode
#   3. Ensure it is owned by the user who runs migrate.sh
#   4. Point the config at it:  SECRETS_FILE=/home/oracle/.migration/secrets.env
#
# PARSING: same line-by-line, non-sourcing parser as the main config. One
# KEY=value per line (an "export KEY=value" prefix is tolerated); blank and '#'
# lines ignored. Every value loaded here is registered for redaction, so it is
# masked in all logs and in the plan output - never echoed in the clear.
#
# Fill in a real value AFTER copying. Leave this .example file with empty values
# so it carries no secret.
#==============================================================================

# SSH password for the oracle user on the TARGET host, used ONLY as a fallback
# for the backup transfer (scp/rsync) and remote commands when passwordless SSH
# keys are not available. Requires 'sshpass' on the host that runs migrate.sh.
# Leave empty to force key-based auth. Prefer SSH keys or TRANSPORT_METHOD=shared;
# a stored password is a weaker security posture. Auto-redacted in all logs.
TRANSPORT_SSH_PASSWORD=

# Password for the SOURCE migration DB user, used ONLY when SOURCE_CONN_MODE=net
# (the source is reached over Oracle Net). The user is set by SOURCE_DB_USER in
# the main config; this password is kept here and auto-redacted in all logs.
SOURCE_DB_PASSWORD=

# Add any other password-/secret-named key here (names containing PASSWORD, PWD,
# or SECRET are auto-redacted). Example:
#MIG_AUX_PASSWORD=
